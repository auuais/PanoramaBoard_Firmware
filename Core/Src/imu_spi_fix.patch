+    }
+
+    memcpy(out, pkt, pkt_len);
+}
+
+/**
+ * @brief Read an IMU response/ACK packet that starts with 0x23 0x23.
+ *
+ * Notes:
+ * - We clock bytes until we find the response header 0x23 0x23 (discarding any leading garbage/echo).
+ * - Then we read the length byte and read exactly (len-3) remaining bytes.
+ * - out_max is a hard cap to avoid overruns.
+ *
+ * @return number of bytes copied into out, or RET_ERROR.
+ */
+static int imu_spi_read_resp_packet(uint8_t *out,
+                                    uint16_t out_max,
+                                    uint32_t timeout_ms)
+{
+    uint8_t tx = 0x00u;
+    uint8_t b  = 0x00u;
+    uint8_t prev = 0x00u;
+
+    if (out == NULL || out_max < 10u) {
+        return RET_ERROR;
+    }
+
+    uint32_t t0 = HAL_GetTick();
+
+    /* Sync to 0x23 0x23 */
+    while ((HAL_GetTick() - t0) < timeout_ms) {
+        if (HAL_SPI_TransmitReceive(&hspi2, &tx, &b, 1u, timeout_ms) != HAL_OK) {
+            return RET_ERROR;
+        }
+        if (prev == 0x23u && b == 0x23u) {
+            out[0] = 0x23u;
+            out[1] = 0x23u;
+            break;
+        }
+        prev = b;
+    }
+
+    if (out[0] != 0x23u || out[1] != 0x23u) {
+        return RET_ERROR;
+    }
+
+    /* Read length byte */
+    uint8_t len = 0u;
+    if (HAL_SPI_TransmitReceive(&hspi2, &tx, &len, 1u, timeout_ms) != HAL_OK) {
+        return RET_ERROR;
+    }
+    out[2] = len;
+
+    if (len < 10u || len > out_max) {
+        return RET_ERROR;
+    }
+
+    /* Read the remaining bytes (len includes header+len byte) */
+    uint16_t remaining = (uint16_t)(len - 3u);
+    for (uint16_t i = 0; i < remaining; i++) {
+        if (HAL_SPI_TransmitReceive(&hspi2, &tx, &out[3u + i], 1u, timeout_ms) != HAL_OK) {
+            return RET_ERROR;
+        }
+    }
+
+    return (int)len;
+}
